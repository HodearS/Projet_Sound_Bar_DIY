			(plot_black_and_white no)
			(sketchpadsonfab no)
			(plotpadnumbers no)
			(hidednponfab no)
			(sketchdnponfab yes)
			(crossoutdnponfab yes)
			(subtractmaskfromsilk no)
			(outputformat 4)
			(mirror no)
			(drillshape 0)
			(scaleselection 1)
			(outputdirectory "C:/Users/nico/Desktop/Gerber/")
		)
	)
